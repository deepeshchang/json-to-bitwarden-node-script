# ─────────────────────────────────────────────────────────────────────────────
# Vaultsmith configuration. Copy to `.env` and edit. Only the Bitwarden auth block
# is required — every other setting has a default (shown here, commented out).
# ─────────────────────────────────────────────────────────────────────────────

# ── Bitwarden auth (REQUIRED: either the API key pair OR a session token) ────
BW_CLIENT_ID=
BW_CLIENT_SECRET=
# Optional: skip the interactive master-password prompt (less safe; prefer the prompt).
# BW_MASTER_PASSWORD=
# Alternative to the API key: a session from `bw unlock --raw`.
# BW_SESSION_ID=
# Required only for add-credentials.
# BW_ORG_ID=
# Path to the Bitwarden CLI. Default "bw" is resolved via PATH.
# BW_CLI_PATH=bw

# ── Input / output files (relative to the project root) ──────────────────────
# Relative paths resolve against the directory you run vaultsmith from.
# Copy the templates in ./examples to ./assets and edit them.
# CREDENTIALS_FILE=assets/creds.json
# UPDATE_PASSWORDS_FILE=assets/updatepasswords.json
# SEARCH_ADMINS_FILE=assets/searchadmins.txt
# SEARCH_NAMES_FILE=assets/searchnames.txt
# LOGIN_CHECKER_FILE=assets/logincheckerusers.txt
# PASSWORD_CHANGER_FILE=assets/passwordchangers.txt
# ADMIN_ACCOUNTS_FILE=assets/admin_accounts.txt
# USER_GROUPS_FILE=assets/usergroups.txt
# CREATE_USERS_OUTPUT_FILE=assets/createdusers.json
# ROTATION_RECOVERY_FILE=assets/rotation-recovery.jsonl

# ── Mutating operations: OFF by default (dry run) ────────────────────────────
# ENABLE_PASSWORD_CHANGE=false
# ENABLE_USER_CREATION=false

# ── Your API: endpoint paths (relative to each vault item's URL) ─────────────
# AUTH_LOGIN_PATH=/authentication/login
# AUTH_CHANGE_PASSWORD_PATH=/authentication/change-password
# API_USERS_PATH=/acl-api/users
# API_USER_BY_ID_PATH=/acl-api/users/{userId}
# API_USER_GROUPS_PATH=/acl-api/users/groups/{entityId}
# API_GROUPS_PATH=/acl-api/groups
# API_REGIONS_PATH=/acl-api/regions
# API_SALESREGIONS_PATH=/acl-api/salesregions
# API_PERMISSIONS_PATH=/acl-api/permissions

# ── Your API: login style ────────────────────────────────────────────────────
# AUTH_MODE=header            # header | basic | json
# AUTH_METHOD=POST
# AUTH_HEADER_NAME=form-content   # header mode: base64("user:pass") goes in this header
# AUTH_USERNAME_FIELD=username    # json mode
# AUTH_PASSWORD_FIELD=password    # json mode
# AUTH_TOKEN_FIELD=access_token   # where the token is in the login response (dot paths ok: data.token)
# AUTH_USER_ID_FIELD=user_id      # only used by check-api-access

# ── Your API: how the token is sent on later calls ───────────────────────────
# TOKEN_TRANSPORT=cookie      # cookie | bearer | header
# TOKEN_NAME=access_token     # cookie name, or header name for TOKEN_TRANSPORT=header

# ── Your API: change-password request ────────────────────────────────────────
# CHANGE_PASSWORD_METHOD=POST
# CHANGE_PASSWORD_OLD_FIELD=old_password
# CHANGE_PASSWORD_NEW_FIELD=new_password
# CHANGE_PASSWORD_ENCODING=base64   # base64 | plain

# ── Your API: response shapes ────────────────────────────────────────────────
# USERS_RESPONSE_KEY=         # e.g. "users" if the list is wrapped as {"users":[...]}
# GROUPS_RESPONSE_KEY=
# USER_FIELD_ID=id
# USER_FIELD_USERNAME=username
# USER_FIELD_EMAIL=email
# USER_FIELD_FIRSTNAME=firstName
# USER_FIELD_LASTNAME=lastName
# GROUP_FIELD_ID=id
# GROUP_FIELD_NAME=name

# ── create-users ─────────────────────────────────────────────────────────────
# NEW_USER_USERNAME=service_user
# NEW_USER_FIRSTNAME=Service
# NEW_USER_LASTNAME=User
# NEW_USER_EMAIL=
# NEW_USER_LANGUAGE=en
# NEW_USER_COLLECTION_ID=      # Bitwarden collection GUID for the generated credentials
# VENDOR_LABEL=
# CREATE_USER_TEMPLATE_FILE=templates/create-user.json
# ENABLE_PERMISSIONS=true
# ENABLE_REGION_SCOPING=true

# ── search-users ─────────────────────────────────────────────────────────────
# EMAIL_DOMAINS=example.com,example.org

# ── Tuning ───────────────────────────────────────────────────────────────────
# BATCH_SIZE=5
# BATCH_DELAY_MS=0
# MAX_RETRIES=3
# REQUEST_TIMEOUT_MS=30000
# LOG_LEVEL=info              # debug | info | warn | error
